# Server & Runtime
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Persistence & Storage
DATABASE_URL=sqlite:///./storage/notebooklm.db
STORAGE_UPLOADS_DIR=./storage/uploads
STORAGE_AUDIO_DIR=./storage/audio
STORAGE_VECTOR_DIR=./storage/vector_store

# Model Providers (gemini | openai | anthropic | ollama)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Embeddings (sentence_transformers | openai | gemini)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Audio Overview (TTS)
TTS_ENGINE=edge-tts
TTS_VOICE_SPEAKER_A=en-US-GuyNeural
TTS_VOICE_SPEAKER_B=en-US-JennyNeural
